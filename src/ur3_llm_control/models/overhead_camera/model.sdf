<?xml version="1.0"?>
<sdf version="1.6"><model name="overhead_camera"><static>true</static><link name="camera_link">
  <sensor name="overhead_rgb" type="camera">
    <always_on>true</always_on><update_rate>10</update_rate><visualize>true</visualize>
    <topic>/camera/image</topic>
    <camera>
      <horizontal_fov>1.20</horizontal_fov>
      <image><width>480</width><height>360</height><format>R8G8B8</format></image>
      <clip><near>0.08</near><far>4.0</far></clip>
    </camera>
  </sensor>
</link></model></sdf>
