<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <gravity>0 0 -9.8</gravity>
    <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre</render_engine></plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.85 0.88 0.92 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 4 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.15 0.15 0.15 1</specular><direction>-0.4 0.3 -1</direction></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
    </link></model>
  <include><uri>model://robot_pedestal</uri><name>robot_pedestal</name><pose>0 0 0.325 0 0 0</pose></include>
  <include><uri>model://work_table</uri><name>work_table</name><pose>0.52 0 0.48 0 0 0</pose></include>
  <include><uri>model://zone_marker</uri><name>zone_a_marker</name><pose>0.43 -0.16 0.501 0 0 0</pose></include>
  <include><uri>model://zone_marker</uri><name>zone_b_marker</name><pose>0.43 0 0.501 0 0 0</pose></include>
  <include><uri>model://zone_marker</uri><name>zone_c_marker</name><pose>0.43 0.16 0.501 0 0 0</pose></include>
  <include><uri>model://red_cube</uri><name>red_cube</name><pose>0.43 -0.16 0.52 0 0 0</pose></include>
  <include><uri>model://blue_cube</uri><name>blue_cube</name><pose>0.43 0 0.52 0 0 0</pose></include>
  <include><uri>model://yellow_cube</uri><name>yellow_cube</name><pose>0.43 0.16 0.52 0 0 0</pose></include>
  <include><uri>model://green_cube</uri><name>green_cube</name><pose>0.25 -0.27 0.52 0 0 0</pose></include>
  <include><uri>model://purple_cube</uri><name>purple_cube</name><pose>0.25 0.27 0.52 0 0 0</pose></include>
  <include><uri>model://overhead_camera</uri><name>overhead_camera</name><pose>1.1 0 1.4 0 0.979 3.14159265359</pose></include>
  </world>
</sdf>